# Copy to `.env` and adjust for local development.
# `backend/.env` itself is gitignored — never commit real secrets.

# SQLite by default; portable to a Postgres URL later without a schema
# rewrite (see communeer/db.py).
DATABASE_URL=sqlite:///./communeer.db

# Used to sign the session cookie (itsdangerous). Use a long random string
# in any shared/deployed environment.
SESSION_SECRET_KEY=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=communeer_session

# Must be "false" for local `uvicorn` dev on plain http://localhost — a
# Secure cookie is silently never sent over a non-TLS connection, and login
# would appear to "not stick". Docker Compose sets this to "true" since
# Caddy terminates TLS there.
SESSION_COOKIE_SECURE=false

# Idempotent: a single admin user is created on startup only if the users
# table is empty.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=changeme123

# Seam for swapping in a real WhatsApp integration later; "mock" (default)
# or "wppconnect".
WHATSAPP_PROVIDER=mock

# Only used when WHATSAPP_PROVIDER=wppconnect. Points at a running
# wppconnect-server instance (see docker-compose.yml's `wppconnect` service);
# in Docker Compose this is the internal service DNS name, never exposed to
# the host.
#WPPCONNECT_BASE_URL=http://localhost:21465
#WPPCONNECT_SECRET_KEY=change-me-to-a-long-random-string
#WPPCONNECT_SESSION_NAME=communeer

# Shared secret for the inbound WPPConnect webhook
# (POST /api/v1/webhooks/wppconnect/{secret}, see communeer/webhooks/router.py).
# Left unset by default so a fresh install has no live webhook path until
# explicitly configured; must match the secret in `wppconnect`'s WEBHOOK_URL.
#WEBHOOK_SECRET=change-me-to-a-long-random-string

# Only relevant when running the backend and frontend as separate dev
# servers on different origins/ports (e.g. `pnpm dev` on 5173).
CORS_ALLOW_ORIGINS=["http://localhost:5173"]
