# Copy to `.env` before running `docker compose up`.

# Signs the backend's session cookie. Use a long random string.
SESSION_SECRET_KEY=change-me-to-a-long-random-string

# Seeded on first boot only (idempotent — ignored if a user already exists).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me

# Required by the wppconnect service regardless of whether WHATSAPP_PROVIDER
# is set to "wppconnect" (the compose file always starts the container).
# Shared with the backend so it can authenticate against it.
WPPCONNECT_SECRET_KEY=change-me-to-a-long-random-string

# Only used when WHATSAPP_PROVIDER=wppconnect (default: mock — see backend's
# own .env.example for the full explanation of this switch).
WHATSAPP_PROVIDER=mock
